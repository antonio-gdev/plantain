# Public demonstration targets
SAUCE_DEMO_URL=https://www.saucedemo.com/
SAUCE_DEMO_USERNAME=standard_user
SAUCE_DEMO_PASSWORD=secret_sauce
PETSTORE_SCHEMA_URL=https://petstore.swagger.io/v2/swagger.json
PETSTORE_API_KEY=special-key

# Runtime
PLANTAIN_PROJECT_ROOT=.
PLANTAIN_ENV=local
PLANTAIN_LOG_LEVEL=INFO

# Optional local dashboard agent. Provider selection is automatic when exactly
# one hosted-provider key is present; otherwise select one in dashboard Settings.
# Model and endpoint choices are non-secret. Custom endpoints must not contain
# credentials, query parameters, or fragments.
PLANTAIN_AGENT_PROVIDER=
PLANTAIN_AGENT_MODEL=
PLANTAIN_AGENT_BASE_URL=
PLANTAIN_AGENT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
PLANTAIN_SCENARIO_TIMEOUT_SECONDS=300
PLANTAIN_STEP_TIMEOUT_SECONDS=60
# Optional shared admission tuning; defaults are safe for a local workstation.
PLANTAIN_MAX_SCENARIO_CONCURRENCY=4
PLANTAIN_MAX_BROWSER_SESSIONS=2
PLANTAIN_MAX_API_REQUESTS=16
PLANTAIN_MAX_DATABASE_OPERATIONS=8
PLANTAIN_MAX_WORKER_THREADS=8
PLANTAIN_MAX_WORKER_PROCESSES=2
# Runtime schema validation is isolated from the main process with all three limits.
PLANTAIN_SCHEMA_VALIDATION_TIMEOUT_SECONDS=10
PLANTAIN_SCHEMA_VALIDATION_CPU_SECONDS=5
PLANTAIN_SCHEMA_VALIDATION_MEMORY_MIB=512

# Browser
PLANTAIN_BROWSER=chromium
# The first UI scenario installs only the configured Playwright browser when absent.
# API and database scenarios never trigger browser provisioning.
PLANTAIN_BROWSER_AUTO_INSTALL=true
PLANTAIN_BROWSER_INSTALL_TIMEOUT_SECONDS=300
PLANTAIN_HEADLESS=true
PLANTAIN_SLOW_MO_MS=0
PLANTAIN_VIEWPORT_WIDTH=1440
PLANTAIN_VIEWPORT_HEIGHT=900
PLANTAIN_ACTION_TIMEOUT_MS=15000
PLANTAIN_NAVIGATION_TIMEOUT_MS=30000
# Snapshot evidence is lossless: byte-envelope exhaustion fails instead of truncating.
# Values are bytes; the working set must not exceed the total capture envelope.
PLANTAIN_SNAPSHOT_MAX_CAPTURE_BYTES=536870912
PLANTAIN_SNAPSHOT_WORKING_SET_BYTES=1048576
PLANTAIN_SNAPSHOT_MAX_NETWORK_CORRELATIONS=10000
# Traces can contain page data. Enabling them requires reviewed governance and an
# encrypted underlying volume; these flags attest external controls rather than creating them.
PLANTAIN_TRACE_MODE=off
PLANTAIN_TRACE_DATA_GOVERNANCE_APPROVED=false
PLANTAIN_TRACE_STORAGE_ENCRYPTED=false
PLANTAIN_TRACE_RETENTION_DAYS=7
PLANTAIN_TRACE_MAX_ARCHIVES=20
PLANTAIN_TRACE_MAX_BYTES=1073741824
PLANTAIN_STORAGE_STATE_PATH=
# Custom Playwright artifact repositories are disabled by default. When a reviewed
# enterprise HTTPS repository is required, set the matching host variable and
# explicitly enable the framework gate. Credentials, queries, fragments, and HTTP
# download hosts are rejected.
PLANTAIN_ALLOW_CUSTOM_PLAYWRIGHT_DOWNLOAD_HOSTS=false
PLAYWRIGHT_DOWNLOAD_HOST=
PLAYWRIGHT_CHROMIUM_DOWNLOAD_HOST=
PLAYWRIGHT_FIREFOX_DOWNLOAD_HOST=
PLAYWRIGHT_WEBKIT_DOWNLOAD_HOST=

# Network policy and API client
# Standard mode permits public HTTPS/WSS after DNS/IP safety validation.
PLANTAIN_NETWORK_MODE=standard
# Optional organization-wide request-method allowlist. Empty permits every supported method.
PLANTAIN_API_ALLOWED_METHODS=
# Optional deny rules apply before all allow rules. Prefix with *. only deliberately.
PLANTAIN_BLOCKED_HOSTS=
# Allow rules are required in restricted mode and for every approved private target.
PLANTAIN_ALLOWED_HOSTS=
PLANTAIN_ALLOW_PRIVATE_NETWORKS=false
# Restricted HTTP/WS, database, and Zephyr access require a real deployment
# firewall/proxy. This attestation does not create the external control.
PLANTAIN_EGRESS_CONTROL_ENFORCED=false
# Plain HTTP/WS additionally requires PLANTAIN_ENV=local, a loopback allowlist entry,
# and PLANTAIN_ALLOW_PRIVATE_NETWORKS=true.
PLANTAIN_ALLOW_INSECURE_LOCAL_HTTP=false
PLANTAIN_API_CONNECT_TIMEOUT_SECONDS=10
PLANTAIN_API_TIMEOUT_SECONDS=30
PLANTAIN_API_MAX_RESPONSE_BYTES=10485760
PLANTAIN_OPENAPI_MAX_BYTES=20971520

# Optional dependency-free Allure raw results for the Plantain CLI.
# HTML generation remains a separate human/CI Allure CLI operation.
PLANTAIN_ALLURE_RESULTS_ENABLED=false

# Optional Zephyr Scale Server/Data Center result publishing. Publishing and
# attachment upload are separate opt-ins and both default to disabled.
# Use the Jira origin/context root only, for example https://jira.example.com
# or https://jira.example.com/jira. Do not append /rest/atm/1.0, credentials,
# a query, or a fragment. Zephyr Scale Cloud uses a different API and is not
# supported by this integration.
JIRA_BASE_URL=
JIRA_PERSONAL_ACCESS_TOKEN=
PLANTAIN_ZEPHYR_PUBLISH_RESULTS=false
# Full native-report attachments may contain sensitive business evidence. Enable both
# attachment flags only after the destination and data handling have been approved.
PLANTAIN_ZEPHYR_ATTACH_REPORT=false
PLANTAIN_ZEPHYR_ATTACHMENT_DATA_GOVERNANCE_APPROVED=false
# Private Server/Data Center hosts require an explicit network-policy opt-in.
PLANTAIN_ZEPHYR_ALLOW_PRIVATE_NETWORKS=false
# HTTPS is required unless a human explicitly accepts insecure HTTP.
PLANTAIN_ZEPHYR_ALLOW_INSECURE_HTTP=false
PLANTAIN_ZEPHYR_TIMEOUT_SECONDS=15
PLANTAIN_ZEPHYR_MAX_RESPONSE_BYTES=1048576
PLANTAIN_ZEPHYR_MAX_ATTACHMENT_BYTES=5242880
PLANTAIN_ZEPHYR_MAX_CONNECTIONS=4
# Durable token-free publication outbox. These controls are used only when
# PLANTAIN_ZEPHYR_PUBLISH_RESULTS=true.
PLANTAIN_ZEPHYR_OUTBOX_MAX_ENTRIES=1000
PLANTAIN_ZEPHYR_OUTBOX_RETRY_BATCH_SIZE=1
PLANTAIN_ZEPHYR_OUTBOX_LOCK_TIMEOUT_SECONDS=5

# Snapshots are complete, content-addressed, and chunked only for transport.

# Database activity source. Credentials are separate and dbUrl must not embed them.
APP_DB_USERNAME=
APP_DB_PASSWORD=
APP_DB_URL=
# Select one full JDBC-style APP_DB_URL appropriate for the target:
# PostgreSQL: jdbc:postgresql://db.example.com:5432/clothing
# SQL Server: jdbc:sqlserver://db.example.com:1433;databaseName=clothing;encrypt=strict;trustServerCertificate=false
# MySQL: jdbc:mysql://db.example.com:3306/clothing?sslMode=VERIFY_IDENTITY
# Oracle: jdbc:oracle:thin:@tcps://db.example.com:1521/clothing
# Authorize each database endpoint as an exact host:port. Private or loopback
# addresses additionally require the explicit private-network opt-in.
PLANTAIN_DB_ALLOWED_TARGETS=
PLANTAIN_DB_ALLOW_PRIVATE_NETWORKS=false
# Insecure TLS is accepted only for loopback hosts in local/development/test and only
# when PLANTAIN_ALLOW_INSECURE_LOCAL_DB_TLS=true. Never use that exception remotely.
PLANTAIN_DB_QUERY_TIMEOUT_SECONDS=15
PLANTAIN_DB_MAX_ROWS=100
PLANTAIN_DB_MAX_COLUMNS=100
PLANTAIN_DB_MAX_RESULT_BYTES=1048576
# Source pools × (pool size + overflow) also has a fixed 256-connection safety ceiling.
# Defaults remain well below it and require no tuning.
PLANTAIN_DB_POOL_SIZE=5
PLANTAIN_DB_MAX_OVERFLOW=0
PLANTAIN_DB_POOL_TIMEOUT_SECONDS=5
PLANTAIN_DB_POOL_RECYCLE_SECONDS=1800
PLANTAIN_DB_MAX_SOURCE_POOLS=8
PLANTAIN_DB_MAX_SOURCES_PER_SCENARIO=4
PLANTAIN_DB_FETCH_BATCH_SIZE=100
PLANTAIN_ALLOW_INSECURE_LOCAL_DB_TLS=false

# Human-only mutation gate. AI-authored scenarios and discovery remain read-only.
PLANTAIN_ALLOW_DB_MUTATIONS=false
